{
  "name": "qr-device-flow",
  "version": "0.0.0",
  "private": true,
  "description": "QR-based cross-device authentication following RFC 8628",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "demo": "pnpm --filter qr-device-flow-example run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^1.13.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9"
}
