{
  "name": "@qr-device-flow/server",
  "version": "0.1.0",
  "description": "Framework-agnostic server for the QR device flow",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qr-device-flow/core": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.12.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "author": "Thauan Almeida",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thauan/qr-device-flow.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Thauan/qr-device-flow/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/Thauan/qr-device-flow/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
